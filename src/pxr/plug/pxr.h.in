#ifndef PXR_PLUG_H
#define PXR_PLUG_H

#include <pxr/arch/pxr.h>
#include <pxr/tf/pxr.h>
#include <pxr/js/pxr.h>
#include <pxr/trace/pxr.h>
#include <pxr/work/pxr.h>

#ifdef PXR_PYTHON_SUPPORT_ENABLED
#include <pxr/boost/python/common.hpp>
#endif

#define PLUG_MAJOR_VERSION @PROJECT_VERSION_MAJOR@
#define PLUG_MINOR_VERSION @PROJECT_VERSION_MINOR@
#define PLUG_PATCH_VERSION @PROJECT_VERSION_PATCH@

#define PLUG_VERSION (PLUG_MAJOR_VERSION * 10000 \
                    + PLUG_MINOR_VERSION * 100   \
                    + PLUG_PATCH_VERSION)

#define PXR_NS pxr
#define PLUG_INTERNAL_NS pxrInternal_v@PROJECT_VERSION_MAJOR@_@PROJECT_VERSION_MINOR@_@PROJECT_VERSION_PATCH@__pxrReserved__
#define PXR_NS_GLOBAL ::PXR_NS

namespace PLUG_INTERNAL_NS { }

namespace PXR_NS {
    using namespace PLUG_INTERNAL_NS;
}

// Import direct dependencies into plug's internal namespace.
// This keeps resolution correct if package versions ever drift.
namespace PLUG_INTERNAL_NS {
    using namespace ARCH_INTERNAL_NS;
    using namespace TF_INTERNAL_NS;
    using namespace JS_INTERNAL_NS;
    using namespace TRACE_INTERNAL_NS;
    using namespace WORK_INTERNAL_NS;
#ifdef PXR_PYTHON_SUPPORT_ENABLED
    using namespace BOOST_INTERNAL_NS;
#endif
}

#define PLUG_NAMESPACE_OPEN_SCOPE   namespace PLUG_INTERNAL_NS {
#define PLUG_NAMESPACE_CLOSE_SCOPE  }
#define PLUG_NAMESPACE_USING_DIRECTIVE using namespace PXR_NS;

#endif // PXR_PLUG_H
